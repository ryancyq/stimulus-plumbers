<h1>List components</h1>

<div id="list-default">
  <%# ── Flat list ──────────────────────────────────────────────────────── %>
  <%= sp_list do |list| %>
    <%= list.item("Profile") %>
    <%= list.item("Settings") %>
    <%= list.item("Help") %>
  <% end %>
</div>

<div id="list-sections">
  <%# ── Grouped with links ─────────────────────────────────────────────── %>
  <%= sp_list(heading_level: 2) do |list| %>
    <%= list.section(title: "Navigation") do |s| %>
      <%= s.item("Dashboard", url: "/") %>
      <%= s.item("Reports",   url: "/") %>
    <% end %>
  <% end %>
</div>

<div id="list-active">
  <%# ── Active item ─────────────────────────────────────────────────────── %>
  <%= sp_list do |list| %>
    <%= list.item("Active item",   active: true) %>
    <%= list.item("Inactive item") %>
  <% end %>
</div>

<div id="list-nested">
  <%# ── Nested sections ────────────────────────────────────────────────── %>
  <%= sp_list(heading_level: 3) do |list| %>
    <%= list.section(title: "Reports") do |s| %>
      <%= s.item("Summary", url: "/") %>
      <%= s.section(title: "Detailed") do |sub| %>
        <%= sub.item("Monthly", url: "/") %>
        <%= sub.item("Annual",  url: "/") %>
      <% end %>
    <% end %>
  <% end %>
</div>

<div id="list-hierarchical">
  <%# ── Multiple sections at h3 ────────────────────────────────────────── %>
  <%= sp_list(heading_level: 3) do |list| %>
    <%= list.section(title: "Navigation") do |s| %>
      <%= s.item("Dashboard", url: "/") %>
      <%= s.item("Reports",   url: "/") %>
    <% end %>

    <%= list.section(title: "Account") do |s| %>
      <%= s.item("Profile") %>
      <%= s.item("Sign out") %>
    <% end %>
  <% end %>
</div>

<div id="list-with-icons">
  <%# List with icon slots %>
  <%= sp_list do |list| %>
    <%= list.item("Dashboard", url: "/") do |slots| %>
      <% slots.with_icon_leading(:home) %>
      <% slots.with_icon_trailing(:"chevron-right") %>
    <% end %>
    <%= list.item("Reports", url: "/") do |slots| %>
      <% slots.with_icon_leading(:"chart-bar") %>
    <% end %>
  <% end %>
</div>
