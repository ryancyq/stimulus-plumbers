<h1>User profile</h1>

<div id="profile">
  <%# ── Profile card ─────────────────────────────────────────────────── %>
  <%= sp_card do |card| %>
    <% card.with_title("Profile") %>
    <% card.with_body do %>
      <%= sp_avatar(initials: "JD", name: "Jane Doe") %>
      <p>Jane Doe</p>
      <p>jane@example.com</p>
      <p>Software engineer passionate about accessible UI components.</p>
      <%= sp_button_group do %>
        <%= sp_button("Edit profile") %>
        <%= sp_button("Change password", variant: :secondary) %>
      <% end %>
    <% end %>
  <% end %>

  <%# ── Preferences card ─────────────────────────────────────────────── %>
  <%= sp_card do |card| %>
    <% card.with_title("Preferences") %>
    <% card.with_body do %>
      <%= sp_list(heading_level: 2) do |list| %>
        <%= list.section(title: "Notifications") do |s| %>
          <%= s.item("Email notifications") %>
          <%= s.item("Push notifications") %>
          <%= s.item("SMS alerts") %>
        <% end %>

        <%= list.section(title: "Account") do |s| %>
          <%= s.item("Privacy settings", url: "#") %>
          <%= s.item("Connected accounts", url: "#") %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>

  <%# ── More options popover ─────────────────────────────────────────── %>
  <%= sp_popover do |p| %>
    <% p.trigger { "More options" } %>
    <% p.panel(role: "dialog", aria: { label: "More options" }) do %>
      <%= sp_list do |list| %>
        <%= list.section do |s| %>
          <%= s.item("Export data",       url: "#") %>
          <%= s.item("Download archive",  url: "#") %>
          <%= s.item("Delete account") %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>

  <%# ── Date picker ──────────────────────────────────────────────────── %>
  <%= sp_combobox_date(label: "Date") %>
</div>
