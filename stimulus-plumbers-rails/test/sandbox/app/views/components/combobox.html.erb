<h1>Combobox components</h1>

<% today = Date.new(2024, 2, 29) %>

<%# ── Date ──────────────────────────────────────────────────────────── %>
<section id="combobox-date" class="sb-section">
  <h2>Date</h2>
  <div class="sb-col">
    <%= sp_combobox_date(id: "birthday", name: "birthday", label: "Birthday", calendar: { today: today }) %>
  </div>
</section>

<%# ── Date (selected, with a range) ──────────────────────────────────── %>
<section id="combobox-date-selected" class="sb-section">
  <h2>Date — Selected, with a range</h2>
  <div class="sb-col">
    <%= sp_combobox_date(id: "deadline", name: "deadline", label: "Deadline", value: Date.new(2024, 2, 15),
                         format: { month: "long", day: "numeric", year: "numeric" },
                         min: "2024-02-03", max: "2024-12-31", calendar: { today: today }) %>
  </div>
</section>

<%# ── Time ──────────────────────────────────────────────────────────── %>
<section id="combobox-time" class="sb-section">
  <h2>Time</h2>
  <div class="sb-col">
    <%= sp_combobox_time(label: "Meeting Time") %>
  </div>
</section>

<%# ── Time (selected) ───────────────────────────────────────────────── %>
<section id="combobox-time-selected" class="sb-section">
  <h2>Time — Selected</h2>
  <div class="sb-col">
    <%= sp_combobox_time(id: "standup", name: "standup", label: "Standup", value: "14:30") %>
  </div>
</section>

<%# ── Time (range) ──────────────────────────────────────────────────── %>
<section id="combobox-time-range" class="sb-section">
  <h2>Time — Range</h2>
  <div class="sb-col">
    <%= sp_combobox_time(id: "opening", name: "opening", label: "Opening", value: "10:00", min: "09:00", max: "17:00", step: 15) %>
  </div>
</section>

<%# ── Date and time ─────────────────────────────────────────────────── %>
<section id="combobox-datetime" class="sb-section">
  <h2>Date and time — Selected, with a range</h2>
  <div class="sb-col">
    <%= sp_combobox_datetime(id: "booking", name: "booking", label: "Booking", value: "2024-02-15T21:00",
                             min: "2024-02-03T09:00", max: "2024-12-31T17:00",
                             time: { min: "09:00", max: "22:00", step: 15 }, calendar: { today: today }) %>
  </div>
</section>

<%# ── Dropdown ───────────────────────────────────────────────────────── %>
<section id="combobox-dropdown" class="sb-section">
  <h2>Dropdown</h2>
  <div class="sb-col">
    <%= sp_combobox_dropdown(
          label:   "Country",
          options: [["Australia", "au"], ["Canada", "ca"], ["United States", "us"]]
        ) %>
  </div>
</section>

<%# ── Typeahead ──────────────────────────────────────────────────────── %>
<section id="combobox-typeahead" class="sb-section">
  <h2>Typeahead</h2>
  <div class="sb-col">
    <%= sp_combobox_typeahead(
          label:   "City",
          options: [["Singapore", "sg"], ["Seoul", "se"], ["Sydney", "sy"]]
        ) %>
  </div>
</section>

<%# ── Preselected ────────────────────────────────────────────────────────── %>
<section id="combobox-preselected" class="sb-section">
  <h2>Preselected value</h2>
  <div class="sb-col">
    <%= sp_combobox_dropdown(
          label:   "Country",
          options: [["Australia", "au"], ["Canada", "ca"], ["United States", "us"]],
          value:   "ca"
        ) %>
  </div>
</section>

<%# ── Grouped ────────────────────────────────────────────────────────────── %>
<section id="combobox-dropdown-grouped" class="sb-section">
  <h2>Grouped, with descriptions</h2>
  <div class="sb-col">
    <%= sp_combobox_dropdown(
          label:   "Country",
          options: [
            { label: "Americas", options: [["Canada", "ca", { description: "North America" }], ["Chile", "cl"]] },
            { label: "Oceania",  options: [["Australia", "au", { description: "Oceania" }]] }
          ]
        ) %>
  </div>
</section>

<%# ── Disabled option ────────────────────────────────────────────────────── %>
<section id="combobox-disabled-option" class="sb-section">
  <h2>Disabled option</h2>
  <div class="sb-col">
    <%= sp_combobox_dropdown(
          label:   "Country",
          options: [
            ["Australia",      "au"],
            ["Canada (n/a)",   "ca", { disabled: true }],
            ["United States",  "us"]
          ]
        ) %>
  </div>
</section>

<%# ── Date (with error) ──────────────────────────────────────────────────── %>
<section id="combobox-date-error" class="sb-section">
  <h2>Date — Error</h2>
  <div class="sb-col">
    <% date_error = SignUp.new.tap { |f| f.errors.add(:birth_date, "is invalid") } %>
    <%= form_with(model: date_error, url: "/demo", scope: "combobox_date_error", builder: StimulusPlumbers::Form::Builder) do |f| %>
      <%= f.field :birth_date, as: :date, label: "Birthday", calendar: { today: today } %>
    <% end %>
  </div>
</section>

<%# ── Time (with error) ──────────────────────────────────────────────────── %>
<section id="combobox-time-error" class="sb-section">
  <h2>Time — Error</h2>
  <div class="sb-col">
    <% time_error = SignUp.new.tap { |f| f.errors.add(:birth_date, "is invalid") } %>
    <%= form_with(model: time_error, url: "/demo", scope: "combobox_time_error", builder: StimulusPlumbers::Form::Builder) do |f| %>
      <%= f.field :birth_date, as: :time, label: "Meeting Time" %>
    <% end %>
  </div>
</section>

<%# ── Dropdown (with error) ──────────────────────────────────────────────── %>
<section id="combobox-dropdown-error" class="sb-section">
  <h2>Dropdown — Error</h2>
  <div class="sb-col">
    <% dropdown_error = SignUp.new.tap { |f| f.errors.add(:country, "is invalid") } %>
    <%= form_with(model: dropdown_error, url: "/demo", scope: "combobox_dropdown_error", builder: StimulusPlumbers::Form::Builder) do |f| %>
      <%= f.field :country, as: :select, label: "Country",
            choices: [["Australia", "au"], ["Canada", "ca"], ["United States", "us"]] %>
    <% end %>
  </div>
</section>

<%# ── Typeahead (remote) ─────────────────────────────────────────────── %>
<section id="combobox-typeahead-remote" class="sb-section">
  <h2>Typeahead (remote)</h2>
  <div class="sb-col">
    <%= sp_combobox_typeahead(id: "remote-city", label: "Remote city", source: "/components/popover/combobox/cities") %>
  </div>
</section>

<%# ── Typeahead (with error) ─────────────────────────────────────────────── %>
<section id="combobox-typeahead-error" class="sb-section">
  <h2>Typeahead — Error</h2>
  <div class="sb-col">
    <% typeahead_error = SignUp.new.tap { |f| f.errors.add(:name, "is invalid") } %>
    <%= form_with(model: typeahead_error, url: "/demo", scope: "combobox_typeahead_error", builder: StimulusPlumbers::Form::Builder) do |f| %>
      <%= f.field :name, as: :search, label: "City", choices: [["Singapore", "sg"], ["Seoul", "se"]] %>
    <% end %>
  </div>
</section>

<%# ── In a modal ────────────────────────────────────────────────────────── %>
<section id="combobox-modal" class="sb-section">
  <h2>In a modal</h2>
  <div class="sb-col">
    <%= sp_modal id: "combobox-dialog", aria_label: "Shipping" do |modal| %>
      <% modal.trigger { "Choose shipping country" } %>
      <% modal.body do %>
        <%= sp_combobox_dropdown(
              label:   "Shipping country",
              options: [["Australia", "au"], ["Canada", "ca"], ["United States", "us"]]
            ) %>
      <% end %>
      <% modal.footer { modal.close_button "Done" } %>
    <% end %>
  </div>
</section>

<%# ── Date in a modal ───────────────────────────────────────────────────── %>
<section id="combobox-date-modal" class="sb-section">
  <h2>Date in a modal</h2>
  <div class="sb-col">
    <%= sp_modal id: "combobox-date-dialog", aria_label: "Trip" do |modal| %>
      <% modal.trigger { "Plan a trip" } %>
      <% modal.body do %>
        <%= sp_combobox_date(id: "departure", name: "departure", label: "Departure", calendar: { today: today }) %>
      <% end %>
      <% modal.footer { modal.close_button "Done" } %>
    <% end %>
  </div>
</section>

<%# ── Time in a modal ───────────────────────────────────────────────────── %>
<section id="combobox-time-modal" class="sb-section">
  <h2>Time in a modal</h2>
  <div class="sb-col">
    <%= sp_modal id: "combobox-time-dialog", aria_label: "Call" do |modal| %>
      <% modal.trigger { "Book a call" } %>
      <% modal.body do %>
        <%= sp_combobox_time(id: "call", name: "call", label: "Call", value: "09:00") %>
      <% end %>
      <% modal.footer { modal.close_button "Done" } %>
    <% end %>
  </div>
</section>
