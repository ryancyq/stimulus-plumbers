<h1>Calendar</h1>

<%# Each calendar reads <id>[displayed] and <id>[level] from params. %>
<% today = Date.new(2026, 9, 10) %>
<%# ?navigation=turbo renders every calendar in Turbo mode. %>
<% navigation = params[:navigation] == "turbo" ? :turbo : :stimulus %>
<% period = ->(id) { { displayed: params.dig(id, "displayed"), level: params.dig(id, "level"), navigation: navigation } } %>

<section id="calendar-inline-month" class="sb-section">
  <h2>Selectable month, with a minimum and weekends unavailable</h2>
  <div class="sb-col">
    <%= sp_calendar id: "calendar-month", today: today, selectable: true, selected: "2026-09-15",
                    min: "2026-09-03", disabled_weekdays: [0, 6], **period.("calendar-month") %>
  </div>
</section>

<section id="calendar-inline-other-months" class="sb-section">
  <h2>Adjacent month days, Monday first</h2>
  <div class="sb-col">
    <%= sp_calendar id: "calendar-other-months", today: today, show_other_months: true, first_day_of_week: 1,
                    **period.("calendar-other-months") %>
  </div>
</section>

<section id="calendar-inline-year" class="sb-section">
  <h2>Year</h2>
  <div class="sb-col">
    <%= sp_calendar id: "calendar-year", today: today, **period.("calendar-year"),
                    level: params.dig("calendar-year", "level") || :year %>
  </div>
</section>

<section id="calendar-inline-decade" class="sb-section">
  <h2>Decade, 2027 unavailable</h2>
  <div class="sb-col">
    <%= sp_calendar id: "calendar-decade", today: today, disabled_years: [2027], **period.("calendar-decade"),
                    level: params.dig("calendar-decade", "level") || :decade %>
  </div>
</section>

<section id="calendar-inline-native" class="sb-section">
  <h2>Native date field</h2>
  <div class="sb-col">
    <%= form_with model: SignUp.new, url: "/demo", scope: :native do |f| %>
      <%= f.label :birth_date, "Start date", for: "calendar-native-date" %>
      <%= f.date_field :birth_date, id: "calendar-native-date" %>
    <% end %>
  </div>
</section>
