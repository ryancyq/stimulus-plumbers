<h1>Avatar components</h1>

<section id="avatar-initials">
  <h2>Initials</h2>
  <div class="sb-row">
    <%= sp_avatar(initials: "SP", name: "Stimulus Plumbers") %>
  </div>
</section>

<section id="avatar-image">
  <h2>Image</h2>
  <div class="sb-row">
    <%= sp_avatar(name: "Jane Doe", url: "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNk+M9QDwADhgGAWjR9awAAAABJRU5ErkJggg==") %>
  </div>
</section>

<section id="avatar-fallback">
  <h2>Fallback</h2>
  <div class="sb-row">
    <%= sp_avatar(name: "Anonymous User") %>
  </div>
</section>

<section id="avatar-sizes">
  <h2>Sizes</h2>
  <div class="sb-row">
    <%= sp_avatar(initials: "SM", name: "Small",  size: :sm) %>
    <%= sp_avatar(initials: "MD", name: "Medium", size: :md) %>
    <%= sp_avatar(initials: "LG", name: "Large",  size: :lg) %>
  </div>
</section>

<section id="avatar-variants">
  <h2>Explicit variants</h2>
  <div class="sb-row">
    <%= sp_avatar(initials: "A",  name: "Amber",   variant: :amber) %>
    <%= sp_avatar(initials: "S",  name: "Sky",     variant: :sky) %>
    <%= sp_avatar(initials: "R",  name: "Rose",    variant: :rose) %>
    <%= sp_avatar(initials: "E",  name: "Emerald", variant: :emerald) %>
  </div>
</section>
