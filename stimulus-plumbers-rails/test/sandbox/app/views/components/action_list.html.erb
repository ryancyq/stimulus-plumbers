<h1>Action list components</h1>

<div id="action-list">
  <%# ── Plain list ─────────────────────────────────────────────────────── %>
  <%= sp_action_list do |list| %>
    <%= list.section do %>
      <%= list.item("Profile") %>
      <%= list.item("Settings") %>
      <%= list.item("Help") %>
    <% end %>
  <% end %>

  <%# ── With links ─────────────────────────────────────────────────────── %>
  <%= sp_action_list do |list| %>
    <%= list.section(title: "Navigation") do %>
      <%= list.item("Dashboard", url: "/") %>
      <%= list.item("Reports",   url: "/") %>
    <% end %>
  <% end %>

  <%# ── Active item ─────────────────────────────────────────────────────── %>
  <%= sp_action_list do |list| %>
    <%= list.section do %>
      <%= list.item("Active item", active: true) %>
      <%= list.item("Inactive item") %>
    <% end %>
  <% end %>
</div>
