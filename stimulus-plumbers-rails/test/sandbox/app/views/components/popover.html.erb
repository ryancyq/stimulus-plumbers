<h1>Popover components</h1>

<div id="popover">
  <%# ── Interactive popover ────────────────────────────────────────────── %>
  <%= sp_popover do |p| %>
    <% p.trigger { "Open menu" } %>
    <% p.panel(role: "dialog", aria: { label: "Menu options" }) do %>
      <%= sp_action_list do %>
        <%= sp_action_list_section do %>
          <%= sp_action_list_item("Edit",   url: "#") %>
          <%= sp_action_list_item("Delete") %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
</div>
