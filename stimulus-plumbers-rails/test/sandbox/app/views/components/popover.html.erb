<h1>Popover components</h1>

<div id="popover">
  <%# ── Interactive popover ────────────────────────────────────────────── %>
  <%= sp_popover do |p| %>
    <% p.trigger { "Open menu" } %>
    <% p.panel(role: "dialog", aria: { label: "Menu options" }) do %>
      <%= sp_list do |list| %>
        <%= list.section do |s| %>
          <%= s.item("Edit",   url: "#") %>
          <%= s.item("Delete") %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
</div>
