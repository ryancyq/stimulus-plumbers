<h1>Button components</h1>

<div id="button">
  <%# ── Types ──────────────────────────────────────────────────────────── %>
  <%= sp_button("Primary") %>
  <%= sp_button("Secondary",   type: :secondary) %>
  <%= sp_button("Destructive", type: :primary, variant: :destructive) %>

  <%# ── Link ───────────────────────────────────────────────────────────── %>
  <%= sp_button("Go to home", url: "/") %>
  <%= sp_button("External", url: "https://example.com", target: "_blank") %>

  <%# ── Disabled ────────────────────────────────────────────────────────── %>
  <%= sp_button("Disabled",           disabled: true) %>
  <%= sp_button("Disabled secondary", type: :secondary, disabled: true) %>

  <%# ── With icons ─────────────────────────────────────────────────────────── %>
  <%= sp_button("Save",   icon_leading: :check) %>
  <%= sp_button("Delete", icon_trailing: :x) %>

  <%# ── Icon only (must have accessible name) ──────────────────────────────── %>
  <%= sp_button(icon_leading: :x, aria: { label: "Close" }) %>
</div>
