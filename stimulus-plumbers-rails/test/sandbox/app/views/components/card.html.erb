<h1>Card components</h1>

<section id="card-default" class="sb-section">
  <h2>Default</h2>
  <div class="sb-col">
    <%= sp_card do |card| card.with_icon("user"); card.with_title("Profile"); card.with_body { "Manage your account settings" }; end %>
    <%= sp_card do |card| card.with_icon("cog"); card.with_title("Settings"); end %>
    <%= sp_card do |card| card.with_title("Help"); card.with_body { "Get support and documentation" }; end %>
  </div>
</section>

<section id="card-cta" class="sb-section">
  <h2>With action</h2>
  <div class="sb-col">
    <%= sp_card do |card| %>
      <% card.with_icon("user") %>
      <% card.with_title("View Profile") %>
      <% card.with_body { "See your public profile" } %>
      <% card.with_action("View", url: "/") %>
    <% end %>
    <%= sp_card do |card| %>
      <% card.with_icon("folder") %>
      <% card.with_title("Archive") %>
      <% card.with_body { "Move items to archive" } %>
      <% card.with_action("Archive") %>
    <% end %>
  </div>
</section>

<section id="card-variants" class="sb-section">
  <h2>Variants</h2>
  <div class="sb-col">
    <%= sp_card(variant: :primary)     do |card| card.with_title("Primary");     card.with_body { "Primary variant" };     end %>
    <%= sp_card(variant: :secondary)   do |card| card.with_title("Secondary");   card.with_body { "Secondary variant" };   end %>
    <%= sp_card(variant: :success)     do |card| card.with_title("Success");     card.with_body { "Action completed" };    end %>
    <%= sp_card(variant: :destructive) do |card| card.with_title("Destructive"); card.with_body { "Destructive action" }; end %>
    <%= sp_card(variant: :warning)     do |card| card.with_title("Warning");     card.with_body { "Proceed with caution" }; end %>
    <%= sp_card(variant: :info)        do |card| card.with_title("Info");        card.with_body { "Informational" };       end %>
  </div>
</section>
