<h1>Search field</h1>

<div id="search">
  <section id="search-default">
    <%= form_with url: "#", scope: :search, builder: StimulusPlumbers::Form::Builder do |f| %>
      <%= f.field :query, as: :search, label: "Search", clearable: true %>
    <% end %>
  </section>

  <section id="search-error">
    <% search_error = Search.new.tap { |f| f.errors.add(:query, "can't be blank") } %>
    <%= form_with(model: search_error, url: "#", builder: StimulusPlumbers::Form::Builder) do |f| %>
      <%= f.field :query, as: :search, label: "Search" %>
    <% end %>
  </section>
</div>
