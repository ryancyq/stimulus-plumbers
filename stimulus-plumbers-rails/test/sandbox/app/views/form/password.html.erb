<h1>Password</h1>

<section id="password-default" class="sb-section">
  <h2>Default</h2>
  <div class="sb-col">
    <%= form_with(model: @form, url: "/demo", scope: "password_default", builder: StimulusPlumbers::Form::Builder) do |f| %>
      <%= f.field :password, as: :password, label: "Password", required: true %>
    <% end %>
  </div>
</section>

<section id="password-revealable" class="sb-section">
  <h2>Revealable</h2>
  <div class="sb-col">
    <%= form_with(model: @form, url: "/demo", scope: "password_revealable", builder: StimulusPlumbers::Form::Builder) do |f| %>
      <%= f.field :password, as: :password, label: "Password", required: true, revealable: true %>
    <% end %>
  </div>
</section>

<section id="password-strength" class="sb-section">
  <h2>Strength</h2>
  <div class="sb-col">
    <%= form_with(model: @form, url: "/demo", scope: "password_strength", builder: StimulusPlumbers::Form::Builder) do |f| %>
      <%= f.field :password, as: :password, label: "Password", required: true do |p| %>
        <% p.enforce min_length: 12, max_length: 64, uppercase: true, digit: true, symbol: true %>
      <% end %>
    <% end %>
  </div>
</section>

<section id="password-strength-revealable" class="sb-section">
  <h2>Strength + reveal</h2>
  <div class="sb-col">
    <%= form_with(model: @form, url: "/demo", scope: "password_strength_revealable", builder: StimulusPlumbers::Form::Builder) do |f| %>
      <%= f.field :password, as: :password, label: "Password", required: true, revealable: true do |p| %>
        <% p.enforce min_length: 12, max_length: 64, digit: true %>
      <% end %>
    <% end %>
  </div>
</section>

<section id="password-error" class="sb-section">
  <h2>Error</h2>
  <div class="sb-col">
    <%= form_with(model: @error_form, url: "/demo", scope: "password_error", builder: StimulusPlumbers::Form::Builder) do |f| %>
      <%= f.field :password, as: :password, label: "Password", required: true, revealable: true %>
    <% end %>
  </div>
</section>
