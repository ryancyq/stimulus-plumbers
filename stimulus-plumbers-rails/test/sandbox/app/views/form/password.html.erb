<h1>Password</h1>

<% fresh = SignUp.new %>
<% error_form = SignUp.new.tap { |f| f.errors.add(:password, "is too short") } %>

<section id="password-default">
  <h2>Default</h2>
  <%= form_with(model: fresh, url: "/demo", scope: "password_default", builder: StimulusPlumbers::Form::Builder) do |f| %>
    <%= f.field :password, as: :password, label: "Password", required: true %>
  <% end %>
</section>

<section id="password-revealable">
  <h2>Revealable</h2>
  <%= form_with(model: fresh, url: "/demo", scope: "password_revealable", builder: StimulusPlumbers::Form::Builder) do |f| %>
    <%= f.field :password, as: :password, label: "Password", required: true, revealable: true %>
  <% end %>
</section>

<section id="password-strength">
  <h2>Strength</h2>
  <%= form_with(model: fresh, url: "/demo", scope: "password_strength", builder: StimulusPlumbers::Form::Builder) do |f| %>
    <%= f.field :password, as: :password, label: "Password", required: true do |p| %>
      <% p.enforce min_length: 12, max_length: 64, uppercase: true, digit: true, symbol: true %>
    <% end %>
  <% end %>
</section>

<section id="password-strength-revealable">
  <h2>Strength + reveal</h2>
  <%= form_with(model: fresh, url: "/demo", scope: "password_strength_revealable", builder: StimulusPlumbers::Form::Builder) do |f| %>
    <%= f.field :password, as: :password, label: "Password", required: true, revealable: true do |p| %>
      <% p.enforce min_length: 12, max_length: 64, digit: true %>
    <% end %>
  <% end %>
</section>

<section id="password-error">
  <h2>Error</h2>
  <%= form_with(model: error_form, url: "/demo", scope: "password_error", builder: StimulusPlumbers::Form::Builder) do |f| %>
    <%= f.field :password, as: :password, label: "Password", required: true, revealable: true %>
  <% end %>
</section>
