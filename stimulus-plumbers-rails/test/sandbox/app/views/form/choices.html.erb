<%
  genders   = [["Male", "male"], ["Female", "female"], ["Other", "other"]]
  interests = [["Reading", "reading"], ["Coding", "coding"], ["Gaming", "gaming"]]
  coll      = { value_method: :last, text_method: :first }
%>

<h1>Form choices</h1>

<%# ── Single Checkbox ─────────────────────────────────────────────── %>

<section id="single-checkbox">
  <h2>Single Checkbox</h2>

  <%= form_with(model: @form, url: "/users", builder: StimulusPlumbers::Form::Builder) do |f| %>
    <%= f.choice :newsletter, as: :check_box, label: "Subscribe to newsletter" %>
    <%= f.choice :newsletter, as: :check_box,
          label: "Free shipping",
          hint:  "We only send weekly product updates" %>
  <% end %>
</section>

<%# ── Collection Checkbox ─────────────────────────────────────────── %>

<section id="collection-checkbox">
  <h2>Collection Checkbox</h2>

  <%= form_with(model: @form, url: "/users", builder: StimulusPlumbers::Form::Builder) do |f| %>
    <%= f.choice :interests, as: :check_box,
          label:      "Interests",
          hint:       "Select all that apply",
          collection: interests, **coll %>
  <% end %>
</section>

<%# ── Collection Radio ────────────────────────────────────────────── %>

<section id="collection-radio">
  <h2>Collection Radio</h2>

  <%= form_with(model: @form, url: "/users", builder: StimulusPlumbers::Form::Builder) do |f| %>
    <%= f.choice :gender, as: :radio,
          label:      "Gender",
          hint:       "Select the option that best describes you",
          collection: genders, **coll %>
  <% end %>
</section>

<%# ── Collection Checkbox (button type) ──────────────────────────── %>

<section id="collection-checkbox-button">
  <h2>Collection Checkbox — Button</h2>

  <%= form_with(model: @form, url: "/users", builder: StimulusPlumbers::Form::Builder) do |f| %>
    <%= f.choice :interests, as: :check_box,
          label:      "Interests",
          type:       :button,
          collection: interests, **coll %>
  <% end %>
</section>

<%# ── Collection Checkbox (card type) ────────────────────────────── %>

<section id="collection-checkbox-card">
  <h2>Collection Checkbox — Card</h2>

  <%= form_with(model: @form, url: "/users", builder: StimulusPlumbers::Form::Builder) do |f| %>
    <%= f.choice :interests, as: :check_box,
          label:      "Interests",
          type:       :card,
          collection: interests, **coll %>
  <% end %>
</section>

<%# ── Collection Radio (button type) ─────────────────────────────── %>

<section id="collection-radio-button">
  <h2>Collection Radio — Button</h2>

  <%= form_with(model: @form, url: "/users", builder: StimulusPlumbers::Form::Builder) do |f| %>
    <%= f.choice :gender, as: :radio,
          label:      "Gender",
          type:       :button,
          collection: genders, **coll %>
  <% end %>
</section>

<%# ── Collection Radio (card type) ───────────────────────────────── %>

<section id="collection-radio-card">
  <h2>Collection Radio — Card</h2>

  <%= form_with(model: @form, url: "/users", builder: StimulusPlumbers::Form::Builder) do |f| %>
    <%= f.choice :gender, as: :radio,
          label:      "Gender",
          type:       :card,
          collection: genders, **coll %>
  <% end %>
</section>

<%# ── Single Checkbox (with error) ────────────────────────────────── %>

<section id="single-checkbox-error">
  <h2>Single Checkbox with error</h2>

  <% single_cb_error = SignUp.new.tap { |f| f.errors.add(:newsletter, "must be accepted") } %>
  <%= form_with(model: single_cb_error, url: "/users", builder: StimulusPlumbers::Form::Builder) do |f| %>
    <%= f.choice :newsletter, as: :check_box, label: "Subscribe to newsletter" %>
  <% end %>
</section>

<%# ── Single Checkbox (required) ─────────────────────────────────── %>

<section id="single-checkbox-required">
  <h2>Single Checkbox required</h2>

  <% single_cb_required = SignUp.new %>
  <%= form_with(model: single_cb_required, url: "/users", builder: StimulusPlumbers::Form::Builder) do |f| %>
    <%= f.choice :newsletter, as: :check_box, label: "Subscribe to newsletter", required: true %>
  <% end %>
</section>

<%# ── Collection Checkbox (with error) ───────────────────────────── %>

<section id="collection-checkbox-error">
  <h2>Collection Checkbox with error</h2>

  <% coll_cb_error = SignUp.new.tap { |f| f.errors.add(:interests, "must select at least one") } %>
  <%= form_with(model: coll_cb_error, url: "/users", builder: StimulusPlumbers::Form::Builder) do |f| %>
    <%= f.choice :interests, as: :check_box,
          label:      "Interests",
          collection: interests, **coll %>
  <% end %>
</section>

<%# ── Collection Radio (with error) ──────────────────────────────── %>

<section id="collection-radio-error">
  <h2>Collection Radio with error</h2>

  <% coll_radio_error = SignUp.new.tap { |f| f.errors.add(:gender, "can't be blank") } %>
  <%= form_with(model: coll_radio_error, url: "/users", builder: StimulusPlumbers::Form::Builder) do |f| %>
    <%= f.choice :gender, as: :radio,
          label:      "Gender",
          collection: genders, **coll %>
  <% end %>
</section>
