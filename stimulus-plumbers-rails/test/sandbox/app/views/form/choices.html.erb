<%
  countries = [
    ["Australia",     "au"],
    ["New Zealand",   "nz"],
    ["Singapore",     "sg"],
    ["United States", "us"]
  ]
%>

<h1>Form choices</h1>

<section id="choices-default" class="sb-section">
  <h2>Default</h2>
  <div class="sb-col">
    <%= form_with(model: @form, url: "/users", scope: "choices_default", builder: StimulusPlumbers::Form::Builder) do |f| %>
    <%= f.choice :gender, as: :radio,
          label:        "Gender",
          collection:   [["male", "Male"], ["female", "Female"], ["other", "Other"]],
          value_method: :first,
          text_method:  :last %>
    <%= f.choice :role, as: :radio,
          label:        "Role",
          collection:   [["admin", "Admin"], ["user", "User"], ["guest", "Guest"]],
          value_method: :first,
          text_method:  :last %>
    <%= f.choice :interests, as: :check_box,
          label:        "Interests",
          collection:   [["ruby", "Ruby"], ["rails", "Rails"], ["js", "JavaScript"]],
          value_method: :first,
          text_method:  :last %>
    <%= f.field :country, as: :select,
          label:   "Country",
          hint:    "Select your country of residence.",
          choices: countries %>
    <%= f.choice :terms_of_service, as: :check_box, label: "I agree to the terms and conditions", required: true %>
    <%= f.submit "Save preferences" %>
  <% end %>
  </div>
</section>
