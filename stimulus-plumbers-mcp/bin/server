#!/usr/bin/env ruby
# frozen_string_literal: true

require "bundler/setup"
require_relative "../lib/stimulus-plumbers-mcp"

server = StimulusPlumbers::MCP::Server.build
warn "[stimulus-plumbers-mcp] server started (version #{StimulusPlumbers::MCP::VERSION})"
transport = MCP::Server::Transports::StdioTransport.new(server)
transport.open
