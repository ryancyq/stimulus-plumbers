<h1>Calendar (Turbo / SSR)</h1>

<section id="calendar-turbo" class="sb-section">
  <h2>Turbo (SSR)</h2>
  <% if @view == "month" %>
    <%= sp_calendar_turbo_month(date: @date, today: @today) %>
  <% elsif @view == "year" %>
    <%= sp_calendar_turbo_year(date: @date, today: @today) %>
  <% elsif @view == "decade" %>
    <%= sp_calendar_turbo_decade(date: @date, today: @today) %>
  <% else %>
    <%= sp_calendar_turbo(date: @date, today: @today, selectable: @selectable, show_other_months: @show_other_months) %>
  <% end %>
</section>
