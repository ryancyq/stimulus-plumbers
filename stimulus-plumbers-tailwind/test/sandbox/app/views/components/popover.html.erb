<h1>Popover components</h1>

<section id="popover" class="sb-section">
  <h2>Default</h2>
  <%# ── Interactive popover ─────────────────────────────────────────────── %>
  <%= sp_popover do |p| %>
    <% p.trigger { "Open menu" } %>
    <% p.panel(role: "dialog", aria: { label: "Menu options" }) do %>
      <%= sp_action_list do |list| %>
        <%= list.section do %>
          <%= list.item("Edit",   url: "#") %>
          <%= list.item("Delete") %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
</section>
