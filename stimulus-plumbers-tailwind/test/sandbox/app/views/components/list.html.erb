<h1>List components</h1>

<section id="list-default" class="sb-section">
  <h2>Default</h2>
  <div class="sb-col">
    <%= sp_list do |list| %>
      <%= list.item("Profile") %>
      <%= list.item("Settings") %>
      <%= list.item("Help") %>
    <% end %>
  </div>
</section>

<section id="list-with-links" class="sb-section">
  <h2>With links</h2>
  <div class="sb-col">
    <%= sp_list(heading_level: 3) do |list| %>
      <%= list.section(title: "Navigation") do |s| %>
        <%= s.item("Dashboard", url: "/") %>
        <%= s.item("Reports",   url: "/") %>
      <% end %>
    <% end %>
  </div>
</section>

<section id="list-active" class="sb-section">
  <h2>Active item</h2>
  <div class="sb-col">
    <%= sp_list do |list| %>
      <%= list.item("Active item",   active: true) %>
      <%= list.item("Inactive item") %>
    <% end %>
  </div>
</section>

<section id="list-with-icons" class="sb-section">
  <h2>With icons</h2>
  <div class="sb-col">
    <%= sp_list do |list| %>
      <%= list.item("Dashboard", url: "/") do |item| %>
        <% item.icon_leading("home") %>
        <% item.icon_trailing("chevron-right") %>
      <% end %>
      <%= list.item(url: "/") do |item| %>
        <% item.icon_leading("chart-bar") %>
        <% item.title("Reports") %>
        <% item.description("Monthly summaries") %>
      <% end %>
    <% end %>
  </div>
</section>
