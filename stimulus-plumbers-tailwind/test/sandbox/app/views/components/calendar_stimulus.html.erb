<h1>Calendar (Stimulus / CSR)</h1>

<div data-controller="combobox-date"
     data-combobox-date-calendar-month-outlet="[data-controller~='calendar-month']">
  <button data-combobox-date-target="viewSwitch"
          data-action="click->combobox-date#zoomOut"
          type="button"></button>

  <section id="calendar-stimulus" class="sb-section">
    <h2>Stimulus (CSR)</h2>
    <div class="sb-col">
      <%= sp_calendar_month(date: @date) %>
    </div>
  </section>
</div>
