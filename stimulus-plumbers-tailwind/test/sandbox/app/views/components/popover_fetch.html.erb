<h1>Popover fetch</h1>

<section id="popover-fetch" class="sb-section">
  <h2>Loaded</h2>
  <div class="sb-row">
    <%= sp_popover(data: { controller: "popover-fetch",
                            popover_fetch_src_value: "/components/popover/menu?region=account-menu",
                            action: "popover:opened->popover-fetch#onOpened popover:closed->popover-fetch#onClosed" }) do |p| %>
      <% p.trigger { "Account" } %>
      <% p.panel(role: :region, aria_label: "Account actions", tabindex: "-1") do %>
        <div id="account-menu" data-popover-fetch-target="region"><a href="#account-menu">Loading account</a></div>
        <div role="status" data-popover-fetch-target="status"></div>
      <% end %>
    <% end %>
  </div>
</section>

<section id="popover-fetch-error" class="sb-section">
  <h2>Failed</h2>
  <div class="sb-row">
    <%= sp_popover(data: { controller: "popover-fetch",
                            popover_fetch_src_value: "/components/popover/menu?region=billing-menu&fail=1",
                            action: "popover:opened->popover-fetch#onOpened popover:closed->popover-fetch#onClosed" }) do |p| %>
      <% p.trigger { "Billing" } %>
      <% p.panel(role: :region, aria_label: "Billing actions", tabindex: "-1") do %>
        <div id="billing-menu" data-popover-fetch-target="region"><a href="#billing-menu">Loading billing</a></div>
        <div role="status" data-popover-fetch-target="status"></div>
      <% end %>
    <% end %>
  </div>
</section>
