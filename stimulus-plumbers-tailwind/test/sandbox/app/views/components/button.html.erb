<section id="button-sizes" class="sb-section">
  <h2>Sizes</h2>
  <%= sp_button("XSmall", size: :xs) %>
  <%= sp_button("Small",  size: :sm) %>
  <%= sp_button("Medium", size: :md) %>
  <%= sp_button("Large",  size: :lg) %>
  <%= sp_button("XLarge", size: :xl) %>
</section>

<section id="button-icons" class="sb-section sb-col">
  <h2>Icons</h2>
  <%# ── Icon leading ───────────────────────────────────────────────────── %>
  <div class="sb-row">
    <%= sp_button("New item",      icon_leading: "plus") %>
    <%= sp_button("Notifications", icon_leading: "bell",  type: :outline, variant: :secondary) %>
    <%= sp_button("Delete",        icon_leading: "trash", type: :fab,     variant: :destructive) %>
  </div>
  <%# ── Icon trailing ──────────────────────────────────────────────────── %>
  <div class="sb-row">
    <%= sp_button("Download",   icon_trailing: "arrow-down-tray") %>
    <%= sp_button("Next",       icon_trailing: "arrow-right") %>
    <%= sp_button("Send",       icon_leading: "envelope", icon_trailing: "arrow-right") %>
  </div>
  <%# ── Icon only ──────────────────────────────────────────────────────── %>
  <div class="sb-row">
    <%= sp_button(icon_leading: "plus",   aria: { label: "Add" }) %>
    <%= sp_button(icon_leading: "pencil", aria: { label: "Edit" }, type: :outline, variant: :secondary) %>
    <%= sp_button(icon_leading: "trash",  aria: { label: "Delete" }, type: :fab,     variant: :destructive) %>
  </div>
</section>

<section id="button-card-icons" class="sb-section sb-cards">
  <h2>Card — With icons</h2>
  <%# ── Card type ──────────────────────────────────────────────────── %>
  <%= sp_button("Get started",         type: :card) %>
  <%= sp_button("View documentation",  type: :card, icon_leading: "book-open") %>
  <%= sp_button("Download",            type: :card, icon_leading: "arrow-down-tray", icon_trailing: "arrow-right") %>
</section>

<section id="button-disabled" class="sb-section sb-row">
  <h2>Disabled</h2>
  <%# ── Disabled ─────────────────────────────────────────────────────────── %>
  <%= sp_button("Default",     type: :default,     disabled: true) %>
  <%= sp_button("Outline",     type: :outline,     disabled: true) %>
  <%= sp_button("Ghost",       type: :ghost,       disabled: true) %>
  <%= sp_button("FAB",         type: :fab,         disabled: true) %>
  <%= sp_button("FAB Outline", type: :fab_outline, disabled: true) %>
  <%= sp_button("Dashed",      type: :dashed,      disabled: true) %>
  <%= sp_button("Card",        type: :card,        disabled: true) %>
</section>
