<h1>Button components</h1>

<div id="button-variants">
  <%# ── default variant (primary color) ──────────────────────────────────── %>
  <%= sp_button("Primary") %>
  <%= sp_button("Secondary",  type: :secondary) %>
  <%= sp_button("Tertiary",   type: :tertiary) %>
  <%= sp_button("Outline",    type: :outline) %>
  <%= sp_button("Ghost",      type: :ghost) %>
  <%= sp_button("FAB",         type: :fab) %>
  <%= sp_button("FAB Outline", type: :fab_outline) %>
  <%= sp_button("Dashed",      type: :dashed) %>
</div>

<div id="button-semantic">
  <%# ── type:primary × all variants ─────────────────────────────────────── %>
  <%= sp_button("Default",     type: :primary) %>
  <%= sp_button("Success",     type: :primary, variant: :success) %>
  <%= sp_button("Destructive", type: :primary, variant: :destructive) %>
  <%= sp_button("Warning",     type: :primary, variant: :warning) %>
  <%= sp_button("Info",        type: :primary, variant: :info) %>
  <%# ── type:outline × all variants ─────────────────────────────────────── %>
  <%= sp_button("Default",     type: :outline) %>
  <%= sp_button("Success",     type: :outline, variant: :success) %>
  <%= sp_button("Destructive", type: :outline, variant: :destructive) %>
  <%= sp_button("Warning",     type: :outline, variant: :warning) %>
  <%= sp_button("Info",        type: :outline, variant: :info) %>
  <%# ── type:ghost × all variants ────────────────────────────────────────── %>
  <%= sp_button("Default",     type: :ghost) %>
  <%= sp_button("Success",     type: :ghost, variant: :success) %>
  <%= sp_button("Destructive", type: :ghost, variant: :destructive) %>
  <%= sp_button("Warning",     type: :ghost, variant: :warning) %>
  <%= sp_button("Info",        type: :ghost, variant: :info) %>
</div>

<div id="button-sizes">
  <%# ── Sizes ──────────────────────────────────────────────────────────── %>
  <%= sp_button("XSmall", size: :xs) %>
  <%= sp_button("Small",  size: :sm) %>
  <%= sp_button("Medium", size: :md) %>
  <%= sp_button("Large",  size: :lg) %>
  <%= sp_button("XLarge", size: :xl) %>
</div>

<div id="button-icons" style="display:flex;flex-direction:column;gap:0.5rem;align-items:flex-start">
  <%# ── Icon leading ───────────────────────────────────────────────────── %>
  <div style="display:flex;gap:0.5rem;align-items:center">
    <%= sp_button("New item",      icon_leading: "plus") %>
    <%= sp_button("Notifications", icon_leading: "bell",  type: :secondary) %>
    <%= sp_button("Delete",        icon_leading: "trash", type: :primary, variant: :destructive) %>
  </div>
  <%# ── Icon trailing ──────────────────────────────────────────────────── %>
  <div style="display:flex;gap:0.5rem;align-items:center">
    <%= sp_button("Download",   icon_trailing: "arrow-down-tray") %>
    <%= sp_button("Next",       icon_trailing: "arrow-right") %>
    <%= sp_button("Send",       icon_leading: "envelope", icon_trailing: "arrow-right") %>
  </div>
  <%# ── Icon only ──────────────────────────────────────────────────────── %>
  <div style="display:flex;gap:0.5rem;align-items:center">
    <%= sp_button(icon_leading: "plus",   aria: { label: "Add" }) %>
    <%= sp_button(icon_leading: "pencil", aria: { label: "Edit" },   type: :secondary) %>
    <%= sp_button(icon_leading: "trash",  aria: { label: "Delete" }, type: :primary, variant: :destructive) %>
  </div>
</div>

<div id="button-link">
  <%# ── Link (use sp_link with type: :button for link-styled buttons) ── %>
  <%= sp_link("Go to home", url: "/",                                      type: :button) %>
  <%= sp_link("External",   url: "https://example.com", target: "_blank",  type: :button) %>
</div>

<div id="button-card" style="display:flex;flex-direction:column;gap:0.5rem;max-width:24rem">
  <%# ── Card type ──────────────────────────────────────────────────── %>
  <%= sp_button("Get started",         type: :card) %>
  <%= sp_button("View documentation",  type: :card, icon_leading: "book-open") %>
  <%= sp_button("Download",            type: :card, icon_leading: "arrow-down-tray", icon_trailing: "arrow-right") %>
  <%# ── Card type × variants ──────────────────────────────────────── %>
  <%= sp_button("Success card",        type: :card, variant: :success) %>
  <%= sp_button("Destructive card",    type: :card, variant: :destructive) %>
</div>

<div id="button-disabled" style="display:flex;gap:0.5rem;align-items:center">
  <%# ── Disabled ─────────────────────────────────────────────────────────── %>
  <%= sp_button("Primary",     disabled: true) %>
  <%= sp_button("Secondary",   type: :secondary,                    disabled: true) %>
  <%= sp_button("Outline",     type: :outline,                      disabled: true) %>
  <%= sp_button("Destructive", type: :primary, variant: :destructive, disabled: true) %>
</div>
