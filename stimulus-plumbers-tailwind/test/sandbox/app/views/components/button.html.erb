<h1>Button components</h1>

<section id="button-default" class="sb-section">
  <h2>Default</h2>
  <%= sp_button("Default Primary", type: :default, variant: :primary) %>
  <%= sp_button("Default Secondary", type: :default, variant: :secondary) %>
  <%= sp_button("Default Tertiary", type: :default, variant: :tertiary) %>
  <%= sp_button("Default Success", type: :default, variant: :success) %>
  <%= sp_button("Default Destructive", type: :default, variant: :destructive) %>
  <%= sp_button("Default Warning", type: :default, variant: :warning) %>
  <%= sp_button("Default Info", type: :default, variant: :info) %>
</section>

