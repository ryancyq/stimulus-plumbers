<h1>User profile</h1>

<section id="profile-default" class="sb-section">
  <h2>User profile</h2>
  <div class="sb-col">
    <%# ── Profile card ─────────────────────────────────────────────────── %>
    <%= sp_card do |card| %>
      <% card.with_icon("user") %>
      <% card.with_title("Profile") %>
      <% card.with_body do %>
        <div class="sb-col">
          <%= sp_avatar(initials: "JD", name: "Jane Doe") %>
          <p>Jane Doe</p>
          <p>jane@example.com</p>
          <p>Software engineer passionate about accessible UI components.</p>
          <%= sp_button_group do %>
            <%= sp_button("Edit profile") %>
            <%= sp_button("Change password", variant: :secondary) %>
          <% end %>
        </div>
      <% end %>
    <% end %>

    <%# ── Preferences card ─────────────────────────────────────────────── %>
    <%= sp_card do |card| %>
      <% card.with_title("Preferences") %>
      <% card.with_body do %>
        <%= sp_list do |list| %>
          <%= list.section(title: "Notifications") do %>
            <%= list.item("Email notifications") %>
            <%= list.item("Push notifications") %>
            <%= list.item("SMS alerts") %>
          <% end %>

          <%= list.section(title: "Account") do %>
            <%= list.item("Privacy settings",    url: "#") %>
            <%= list.item("Connected accounts",  url: "#") %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>

    <%# ── More options popover ─────────────────────────────────────────── %>
    <%= sp_popover do |p| %>
      <% p.trigger { "More options" } %>
      <% p.panel(role: "dialog", aria: { label: "More options" }) do %>
        <%= sp_list do |list| %>
          <%= list.section do %>
            <%= list.item("Export data",      url: "#") %>
            <%= list.item("Download archive", url: "#") %>
            <%= list.item("Delete account") %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>

    <%# ── Date picker ──────────────────────────────────────────────────── %>
    <%= sp_combobox_date(label: "Date") %>
  </div>
</section>
