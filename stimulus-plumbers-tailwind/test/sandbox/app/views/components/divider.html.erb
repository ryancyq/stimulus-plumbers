<h1>Divider components</h1>

<%# ── Plain divider ───────────────────────────────────────────────────── %>
<section id="divider-plain" class="sb-section" aria-label="Plain divider">
  <p>Section above</p>
  <%= sp_divider %>
  <p>Section below</p>
</section>

<%# ── Labeled divider ─────────────────────────────────────────────────── %>
<section id="divider-labeled" class="sb-section" aria-label="Labeled divider">
  <p>Sign in with email</p>
  <%= sp_divider("OR") %>
  <p>Sign in with Google</p>
</section>
