<h1>Avatar components</h1>

<section id="avatar-initials" class="sb-section">
  <h2>Initials</h2>
  <div class="sb-row">
    <%# ── Initials with name ──────────────────────────────────────────────── %>
    <%= sp_avatar(initials: "SP", name: "Stimulus Plumbers") %>
  </div>
</section>

<section id="avatar-image" class="sb-section">
  <h2>Image</h2>
  <div class="sb-row">
    <%# ── Image with name ─────────────────────────────────────────────────── %>
    <%= sp_avatar(name: "Jane Doe", url: "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNk+M9QDwADhgGAWjR9awAAAABJRU5ErkJggg==") %>
  </div>
</section>

<section id="avatar-fallback" class="sb-section">
  <h2>Fallback</h2>
  <div class="sb-row">
    <%# ── Fallback SVG with name ──────────────────────────────────────────── %>
    <%= sp_avatar(name: "Anonymous User") %>
  </div>
</section>

<section id="avatar-sizes" class="sb-section">
  <h2>Sizes</h2>
  <div class="sb-row">
    <%# ── Sizes ───────────────────────────────────────────────────────────── %>
    <%= sp_avatar(initials: "SM", name: "Small",  size: :sm) %>
    <%= sp_avatar(initials: "MD", name: "Medium", size: :md) %>
    <%= sp_avatar(initials: "LG", name: "Large",  size: :lg) %>
  </div>
</section>
