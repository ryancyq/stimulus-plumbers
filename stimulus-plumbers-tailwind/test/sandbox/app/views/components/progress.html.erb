<h1>Progress components</h1>

<section id="progress-bar" class="sb-section">
  <h2>Bar</h2>
  <div class="sb-row">
    <%= sp_progress_bar(value: 65, max: 100, aria: { label: "Upload progress" }) %>
  </div>
</section>

<section id="progress-bar-indeterminate" class="sb-section">
  <h2>Bar — indeterminate</h2>
  <div class="sb-row">
    <%= sp_progress_bar(value: 0, indeterminate: true, aria: { label: "Loading" }) %>
  </div>
</section>

<section id="progress-segmented" class="sb-section">
  <h2>Segmented</h2>
  <div class="sb-row">
    <%= sp_progress_segmented(value: 6, segments: 5, max: 10, aria: { label: "Onboarding steps" }) %>
  </div>
</section>

<section id="progress-segmented-ramp" class="sb-section">
  <h2>Segmented — strength ramp</h2>
  <div class="sb-row">
    <%= sp_progress_segmented(value: 4, segments: 5, max: 5, ramp: :strength, aria: { label: "Password strength" }) %>
  </div>
</section>

<section id="progress-segmented-indeterminate-3" class="sb-section">
  <h2>Segmented — indeterminate (3 segments)</h2>
  <div class="sb-row">
    <%= sp_progress_segmented(value: 0, segments: 3, max: 10, indeterminate: true, aria: { label: "Loading" }) %>
  </div>
</section>

<section id="progress-segmented-indeterminate" class="sb-section">
  <h2>Segmented — indeterminate (5 segments)</h2>
  <div class="sb-row">
    <%= sp_progress_segmented(value: 0, segments: 5, max: 10, indeterminate: true, aria: { label: "Loading" }) %>
  </div>
</section>

<section id="progress-segmented-indeterminate-10" class="sb-section">
  <h2>Segmented — indeterminate (10 segments)</h2>
  <div class="sb-row">
    <%= sp_progress_segmented(value: 0, segments: 10, max: 10, indeterminate: true, aria: { label: "Loading" }) %>
  </div>
</section>

<section id="progress-ring" class="sb-section">
  <h2>Ring</h2>
  <div class="sb-row">
    <%= sp_progress_ring(value: 60, max: 100, aria: { label: "Storage used" }) %>
  </div>
</section>

<section id="progress-ring-lg" class="sb-section">
  <h2>Ring — large</h2>
  <div class="sb-row">
    <%= sp_progress_ring(value: 60, max: 100, size: :lg, aria: { label: "Storage used" }) %>
  </div>
</section>

<section id="progress-ring-indeterminate" class="sb-section">
  <h2>Ring — indeterminate</h2>
  <div class="sb-row">
    <%= sp_progress_ring(value: 0, indeterminate: true, aria: { label: "Loading" }) %>
  </div>
</section>

<section id="progress-meter" class="sb-section">
  <h2>Meter</h2>
  <div class="sb-row">
    <%= sp_progress_meter(value: 6, min: 0, max: 10, low: 3, high: 8, optimum: 9, aria: { label: "Disk usage" }) %>
  </div>
</section>

<section id="progress-bar-percent" class="sb-section">
  <h2>Bar — percent readout</h2>
  <div class="sb-row">
    <%= sp_progress_bar(value: 45, format: :percent, aria: { label: "Upload progress" }) %>
  </div>
</section>

<section id="progress-bar-value-max" class="sb-section">
  <h2>Bar — value / max readout</h2>
  <div class="sb-row">
    <%= sp_progress_bar(value: 45, max: 100, format: :value_max, aria: { label: "Upload progress" }) %>
  </div>
</section>

<section id="progress-bar-percent-low" class="sb-section">
  <h2>Bar — percent readout at 4%</h2>
  <div class="sb-row">
    <%= sp_progress_bar(value: 4, format: :percent, aria: { label: "Upload progress" }) %>
  </div>
</section>

<section id="progress-bar-percent-full" class="sb-section">
  <h2>Bar — percent readout at 100%</h2>
  <div class="sb-row">
    <%= sp_progress_bar(value: 100, format: :percent, aria: { label: "Upload progress" }) %>
  </div>
</section>
