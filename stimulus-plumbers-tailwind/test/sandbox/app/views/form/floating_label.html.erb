    <% end %>
  </div>
</section>

<section id="floating-outlined-error" class="sb-section">
  <h2>Outlined — error</h2>
  <div class="sb-col">
    <%= form_with(model: @error_form, url: "/demo", builder: StimulusPlumbers::Form::Builder) do |f| %>
      <%= f.field :name, as: :text, label: "Full name", required: true, floating: :outlined %>
    <% end %>
  </div>
</section>

<%# ── Standard ─────────────────────────────────────────────────────────── %>

<section id="floating-standard" class="sb-section">
  <h2>Standard</h2>
  <div class="sb-col">
    <%= form_with(model: SignUp.new, url: "/demo", builder: StimulusPlumbers::Form::Builder) do |f| %>
      <%= f.field :name, as: :text, label: "Full name", required: true, floating: :standard %>
    <% end %>
  </div>
</section>

<section id="floating-standard-error" class="sb-section">
  <h2>Standard — error</h2>
