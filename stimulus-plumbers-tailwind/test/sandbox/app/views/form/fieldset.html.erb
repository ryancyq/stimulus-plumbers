<%
  genders = [["male", "Male"], ["female", "Female"], ["other", "Other"]]
  hobbies = [["reading", "Reading"], ["coding", "Coding"], ["gaming", "Gaming"]]
%>

<h1>Fieldset components</h1>

<%# ── Collection radio buttons, no error ─────────────────────────────── %>
<section id="fieldset-radio" class="sb-section">
  <h2>Radio — Default</h2>
  <% fresh = SignUp.new %>
  <%= form_with(model: fresh, url: "/demo", scope: "fieldset_radio", builder: StimulusPlumbers::Form::Builder) do |f| %>
    <%= f.choice :gender, as: :radio,
          label: "Gender", collection: genders, value_method: :first, text_method: :last %>
  <% end %>
</section>

<%# ── Collection radio buttons with error ─────────────────────────────── %>
<section id="fieldset-radio-error" class="sb-section">
  <h2>Radio — Error</h2>
  <%= form_with(model: @form, url: "/demo", scope: "fieldset_radio_error", builder: StimulusPlumbers::Form::Builder) do |f| %>
    <%= f.choice :gender, as: :radio,
          label: "Gender", collection: genders, value_method: :first, text_method: :last %>
  <% end %>
</section>

<%# ── Collection radio buttons required ──────────────────────────────── %>
<section id="fieldset-radio-required" class="sb-section">
  <h2>Radio — Required</h2>
  <% required_form = SignUp.new %>
  <%= form_with(model: required_form, url: "/demo", scope: "fieldset_radio_required", builder: StimulusPlumbers::Form::Builder) do |f| %>
    <%= f.choice :gender, as: :radio,
          label: "Gender", collection: genders, value_method: :first, text_method: :last, required: true %>
  <% end %>
</section>

<%# ── Collection check boxes, no error ────────────────────────────────── %>
<section id="fieldset-checkbox" class="sb-section">
  <h2>Checkbox — Default</h2>
  <% fresh2 = SignUp.new %>
  <%= form_with(model: fresh2, url: "/demo", scope: "fieldset_checkbox", builder: StimulusPlumbers::Form::Builder) do |f| %>
    <%= f.choice :interests, as: :check_box,
          label: "Interests", collection: hobbies, value_method: :first, text_method: :last %>
  <% end %>
</section>

<%# ── Collection check boxes with error ───────────────────────────────── %>
<section id="fieldset-checkbox-error" class="sb-section">
  <h2>Checkbox — Error</h2>
  <%= form_with(model: @form, url: "/demo", scope: "fieldset_checkbox_error", builder: StimulusPlumbers::Form::Builder) do |f| %>
    <%= f.choice :interests, as: :check_box,
          label: "Interests", collection: hobbies, value_method: :first, text_method: :last %>
  <% end %>
</section>

<%# ── Collection radio buttons with hint ──────────────────────────────── %>
<section id="fieldset-radio-hint" class="sb-section">
  <h2>Radio — Hint</h2>
  <% radio_hint = SignUp.new %>
  <%= form_with(model: radio_hint, url: "/demo", scope: "fieldset_radio_hint", builder: StimulusPlumbers::Form::Builder) do |f| %>
    <%= f.choice :gender, as: :radio,
          label: "Gender", collection: genders, value_method: :first, text_method: :last,
          hint: "Select the option that best describes you." %>
  <% end %>
</section>

<%# ── Collection check boxes required ─────────────────────────────────── %>
<section id="fieldset-checkbox-required" class="sb-section">
  <h2>Checkbox — Required</h2>
  <% checkbox_required = SignUp.new %>
  <%= form_with(model: checkbox_required, url: "/demo", scope: "fieldset_checkbox_required", builder: StimulusPlumbers::Form::Builder) do |f| %>
    <%= f.choice :interests, as: :check_box,
          label: "Interests", collection: hobbies, value_method: :first, text_method: :last,
          required: true %>
  <% end %>
</section>

<%# ── Collection check boxes with hint ────────────────────────────────── %>
<section id="fieldset-checkbox-hint" class="sb-section">
  <h2>Checkbox — Hint</h2>
  <% checkbox_hint = SignUp.new %>
  <%= form_with(model: checkbox_hint, url: "/demo", scope: "fieldset_checkbox_hint", builder: StimulusPlumbers::Form::Builder) do |f| %>
    <%= f.choice :interests, as: :check_box,
          label: "Interests", collection: hobbies, value_method: :first, text_method: :last,
          hint: "Select all that apply." %>
  <% end %>
</section>
