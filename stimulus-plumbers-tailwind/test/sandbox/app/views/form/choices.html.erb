<%# ── Single Checkbox (with error) ────────────────────────────────── %>

<section id="single-checkbox-error" class="sb-section">
  <h2>Single Checkbox — Error</h2>

  <% single_cb_error = SignUp.new.tap { |f| f.errors.add(:newsletter, "must be accepted") } %>
  <%= form_with(model: single_cb_error, url: "/users", builder: StimulusPlumbers::Form::Builder) do |f| %>
    <%= f.choice :newsletter, as: :check_box, label: "Subscribe to newsletter" %>
  <% end %>
</section>

