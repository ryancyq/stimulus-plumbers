<%
  genders    = [["Male", "male"], ["Female", "female"], ["Other", "other"]]
  interests  = [["Ruby", "ruby"], ["Rails", "rails"], ["JavaScript", "js"]]
  collection = { value_method: :last, text_method: :first }
  countries  = [
    ["Australia",     "au"],
    ["New Zealand",   "nz"],
    ["Singapore",     "sg"],
    ["United States", "us"]
  ]
%>

<h1>Form choices</h1>

<div id="choices-default">
  <%= sp_card do %>
    <%= form_with(model: @form, url: "/users", builder: StimulusPlumbers::Form::Builder) do |f| %>
    <%= f.choice :gender, as: :radio,
          label:        "Gender",
          collection:   [["male", "Male"], ["female", "Female"], ["other", "Other"]],
          value_method: :first,
          text_method:  :last %>
    <%= f.choice :role, as: :radio,
          label:        "Role",
          collection:   [["admin", "Admin"], ["user", "User"], ["guest", "Guest"]],
          value_method: :first,
          text_method:  :last %>
    <%= f.choice :interests, as: :check_box,
          label:        "Interests",
          collection:   [["ruby", "Ruby"], ["rails", "Rails"], ["js", "JavaScript"]],
          value_method: :first,
          text_method:  :last %>
    <%= f.field :country, as: :select,
          label:   "Country",
          hint:    "Select your country of residence.",
          choices: countries %>
    <%= f.choice :newsletter, as: :check_box, label: "Subscribe to newsletter" %>
    <%= f.submit "Save preferences" %>
  <% end %>
  <% end %>
</div>

<%# ── Single Checkbox ─────────────────────────────────────────────── %>

<section id="single-checkbox">
  <h2>Single Checkbox</h2>

  <div id="single-checkbox-default">
    <%= sp_card do %>
      <%= form_with(model: @form, url: "/users", builder: StimulusPlumbers::Form::Builder) do |f| %>
        <%= f.choice :newsletter, as: :check_box, label: "Subscribe to newsletter" %>
      <% end %>
    <% end %>
  </div>

  <div id="single-checkbox-hint">
    <%= sp_card do %>
      <%= form_with(model: @form, url: "/users", builder: StimulusPlumbers::Form::Builder) do |f| %>
        <%= f.choice :newsletter, as: :check_box,
              label: "Free shipping",
              hint:  "We only send weekly product updates" %>
      <% end %>
    <% end %>
  </div>
</section>

<%# ── Collection Checkbox ─────────────────────────────────────────── %>

<section id="collection-checkbox">
  <h2>Collection Checkbox</h2>

  <div id="collection-checkbox-stacked">
    <%= sp_card do %>
      <%= form_with(model: @form, url: "/users", builder: StimulusPlumbers::Form::Builder) do |f| %>
        <%= f.choice :interests, as: :check_box,
              label:      "Interests",
              layout:     :stacked,
              collection: interests, **collection %>
      <% end %>
    <% end %>
  </div>

  <div id="collection-checkbox-button">
    <%= sp_card do %>
      <%= form_with(model: @form, url: "/users", builder: StimulusPlumbers::Form::Builder) do |f| %>
        <%= f.choice :interests, as: :check_box,
              label:      "Interests",
              variant:    :button,
              collection: interests, **collection %>
      <% end %>
    <% end %>
  </div>

  <div id="collection-checkbox-card">
    <%= sp_card do %>
      <%= form_with(model: @form, url: "/users", builder: StimulusPlumbers::Form::Builder) do |f| %>
        <%= f.choice :interests, as: :check_box,
              label:      "Interests",
              variant:    :card,
              collection: interests, **collection %>
      <% end %>
    <% end %>
  </div>
</section>

<%# ── Collection Radio ────────────────────────────────────────────── %>

<section id="collection-radio">
  <h2>Collection Radio</h2>

  <div id="collection-radio-stacked">
    <%= sp_card do %>
      <%= form_with(model: @form, url: "/users", builder: StimulusPlumbers::Form::Builder) do |f| %>
        <%= f.choice :gender, as: :radio,
              label:      "Gender",
              layout:     :stacked,
              collection: genders, **collection %>
      <% end %>
    <% end %>
  </div>

  <div id="collection-radio-button">
    <%= sp_card do %>
      <%= form_with(model: @form, url: "/users", builder: StimulusPlumbers::Form::Builder) do |f| %>
        <%= f.choice :gender, as: :radio,
              label:      "Gender",
              variant:    :button,
              collection: genders, **collection %>
      <% end %>
    <% end %>
  </div>

  <div id="collection-radio-card">
    <%= sp_card do %>
      <%= form_with(model: @form, url: "/users", builder: StimulusPlumbers::Form::Builder) do |f| %>
        <%= f.choice :gender, as: :radio,
              label:      "Gender",
              variant:    :card,
              collection: genders, **collection %>
      <% end %>
    <% end %>
  </div>
</section>
