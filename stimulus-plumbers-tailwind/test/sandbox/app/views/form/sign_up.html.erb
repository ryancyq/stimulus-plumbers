<h1>Create account</h1>

<section id="sign-up" class="sb-section">
  <h2>Default</h2>
  <div class="sb-col">
    <%= form_with(model: @form, url: "/users", scope: "sign_up_default", builder: StimulusPlumbers::Form::Builder) do |f| %>
      <%= f.field :name,       as: :text,     label: "Full name",     required: true %>
      <%= f.field :email,      as: :email,    label: "Email address", required: true,
                                              hint: "We'll never share your email." %>
      <%= f.field :password,   as: :password, label: "Password",      required: true, revealable: true %>
      <%= f.field :birth_date, as: :date,     label: "Date of birth" %>
      <%= f.field :bio,        as: :text_area, label: "Bio",
                                              hint: "Tell us a little about yourself." %>
      <%= f.submit "Create account" %>
    <% end %>

    <%= sp_link("Sign in", url: "#", variant: :default) %>
  </div>
</section>

<section id="sign-up-floating" class="sb-section">
  <h2>Floating labels</h2>
  <div class="sb-col">
    <%= form_with(model: @form, url: "/users", scope: "sign_up_floating", builder: StimulusPlumbers::Form::Builder) do |f| %>
      <%= f.field :name,     as: :text,     label: "Full name",     required: true, floating: :outlined %>
      <%= f.field :email,    as: :email,    label: "Email address", required: true, floating: :outlined %>
      <%= f.field :password, as: :password, label: "Password",      required: true, floating: :outlined, revealable: true %>
      <%= f.submit "Create account" %>
    <% end %>
  </div>
</section>
