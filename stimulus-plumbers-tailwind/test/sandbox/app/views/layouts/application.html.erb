<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Stimulus Plumbers Tailwind Sandbox</title>
    <link rel="stylesheet" href="/tailwind.css">
    <script type="importmap">
      { "imports": { "@hotwired/stimulus": "/node_modules/@hotwired/stimulus/dist/stimulus.js" } }
    </script>
  </head>
  <body class="text-gray-900 bg-white">
    <main class="container mx-auto py-4">
      <%= yield %>
    </main>
    <script type="module">
      import { Application } from "@hotwired/stimulus";
      import * as StimulusPlumbers from "/dist/index.es.js";

      const app = Application.start();

      Object.entries(StimulusPlumbers)
        .filter(([name]) => name.endsWith("Controller"))
        .forEach(([name, controller]) => {
          const identifier = name
            .replace("Controller", "")
            .replace(/([a-z])([A-Z])/g, "$1-$2")
            .toLowerCase();
          app.register(identifier, controller);
        });
    </script>
  </body>
</html>
