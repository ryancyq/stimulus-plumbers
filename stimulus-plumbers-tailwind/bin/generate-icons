#!/usr/bin/env ruby
# frozen_string_literal: true

require "rexml/document"

HEROICONS_DIR = ARGV[0] || File.expand_path("../../../heroicons", __dir__)
OUTPUT_FILE   = File.expand_path("../lib/stimulus_plumbers/themes/tailwind/icon.rb", __dir__)

abort "heroicons not found at #{HEROICONS_DIR}" unless Dir.exist?(HEROICONS_DIR)

OUTLINE_DIR = File.join(HEROICONS_DIR, "optimized/24/outline")
SOLID_DIR   = File.join(HEROICONS_DIR, "optimized/24/solid")

PATH_SVG_ATTRS = {
  "fill-rule"       => :fill_rule,
  "clip-rule"       => :clip_rule,
  "stroke-linecap"  => :stroke_linecap,
  "stroke-linejoin" => :stroke_linejoin
}.freeze

def parse_paths(svg_content)
  doc = REXML::Document.new(svg_content)
  paths = []

  doc.root.elements.each("path") do |el|
    d = el.attributes["d"]
    next unless d

    attrs = { d: d }
    PATH_SVG_ATTRS.each do |svg_attr, ruby_key|
      val = el.attributes[svg_attr]
      attrs[ruby_key] = val.to_sym if val
    end
    paths << attrs
  end

  paths
end

def format_path_element(attrs)
  parts = ["tag: :path"]
  %i[fill_rule clip_rule stroke_linecap stroke_linejoin].each do |key|
    parts << "#{key}: :#{attrs[key]}" if attrs[key]
  end
  parts << "d: #{attrs[:d].inspect}"
  "{ #{parts.join(", ")} }"
end

def format_icon_entry(key, svg_overrides, paths)
  svg_parts = svg_overrides.map { |k, v| "#{k}: #{v.inspect}" }
  svg_str   = svg_parts.empty? ? "" : "#{svg_parts.join(", ")}, "

  if paths.size == 1
    el_str = format_path_element(paths.first)
    "          #{key.inspect} => { #{svg_str}elements: [#{el_str}] }"
  else
    el_lines = paths.map { |p| "            #{format_path_element(p)}" }.join(",\n")
    "          #{key.inspect} => { #{svg_str}elements: [\n#{el_lines}\n          ] }"
  end
end

# Collect entries keyed by base name so outline + solid stay adjacent
entries = {}

Dir.glob(File.join(OUTLINE_DIR, "*.svg")).sort.each do |file|
  name  = File.basename(file, ".svg")
  paths = parse_paths(File.read(file))
  next if paths.empty?

  entries[name] ||= {}
  entries[name][:outline] = paths
end

Dir.glob(File.join(SOLID_DIR, "*.svg")).sort.each do |file|
  name  = File.basename(file, ".svg")
  paths = parse_paths(File.read(file))
  next if paths.empty?

  entries[name] ||= {}
  entries[name][:solid] = paths
end

lines = []
entries.keys.sort.each do |name|
  data = entries[name]

  if data[:outline]
    lines << format_icon_entry(name, {}, data[:outline])
  end

  if data[:solid]
    solid_overrides = { fill: "currentColor", stroke: "none" }
    lines << format_icon_entry("#{name}/solid", solid_overrides, data[:solid])
  end
end

output = <<~RUBY
  # frozen_string_literal: true

  # This file is generated by bin/generate_icons — do not edit manually.

  module StimulusPlumbers
    module Themes
      module Tailwind
        module Icon
          ICONS = {
  #{lines.join(",\n")}
          }.freeze

          def icons
            ICONS
          end

          private

          def icon_classes
            { classes: "size-6" }
          end
        end
      end
    end
  end
RUBY

File.write(OUTPUT_FILE, output)
puts "Wrote #{entries.size} icons (#{lines.size} entries) to #{OUTPUT_FILE}"
