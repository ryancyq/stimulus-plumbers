{
  "name": "@stimulus-plumbers/controllers",
  "version": "0.4.15",
  "description": "Stimulus controllers following WCAG standards",
  "type": "module",
  "main": "dist/index.umd.js",
  "module": "dist/index.es.js",
  "exports": {
    ".": {
      "import": "./dist/index.es.js",
      "require": "./dist/index.umd.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && node --run build:manifest",
    "build:manifest": "node scripts/build-controllers-manifest.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src",
    "format:write": "prettier --write \"src/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.js\""
  },
  "keywords": [
    "accessibility",
    "a11y",
    "stimulus",
    "hotwire",
    "aria"
  ],
  "author": "Ryan Chang",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ryancyq/stimulus-plumbers",
    "directory": "stimulus"
  },
  "peerDependencies": {
    "@hotwired/stimulus": "^3.0.0 || ^2.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@hotwired/stimulus": "^3.2.2",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.1.4",
    "axe-core": "^4.12.1",
    "eslint": "^10.2.0",
    "globals": "^17.4.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.3.3",
    "vite": "^8.0.4",
    "vitest": "^4.1.4"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
