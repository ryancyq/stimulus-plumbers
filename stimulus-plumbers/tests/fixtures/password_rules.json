[
  {
    "name": "all rules met",
    "rules": [
      { "key": "length", "min": 8, "max": 64 },
      { "key": "uppercase", "pattern": "[A-Z]", "min": 1 },
      { "key": "digit", "pattern": "\\d", "min": 2 }
    ],
    "password": "Abcdef12",
    "expected": { "rules": { "length": true, "uppercase": true, "digit": true }, "valid": true }
  },
  {
    "name": "too short and one digit",
    "rules": [
      { "key": "length", "min": 8, "max": 64 },
      { "key": "digit", "pattern": "\\d", "min": 2 }
    ],
    "password": "ab1",
    "expected": { "rules": { "length": false, "digit": false }, "valid": false }
  },
  {
    "name": "max occurrence exceeded",
    "rules": [{ "key": "digit", "pattern": "\\d", "min": 0, "max": 2 }],
    "password": "a123",
    "expected": { "rules": { "digit": false }, "valid": false }
  },
  {
    "name": "occurrence within max bound",
    "rules": [{ "key": "digit", "pattern": "\\d", "min": 0, "max": 2 }],
    "password": "a12",
    "expected": { "rules": { "digit": true }, "valid": true }
  },
  {
    "name": "forbid whitespace",
    "rules": [{ "key": "no_spaces", "pattern": "\\s", "min": 0, "max": 0 }],
    "password": "a b",
    "expected": { "rules": { "no_spaces": false }, "valid": false }
  },
  {
    "name": "negated rule satisfied",
    "rules": [{ "key": "no_spaces", "pattern": "\\s", "min": 0, "max": 0 }],
    "password": "abc",
    "expected": { "rules": { "no_spaces": true }, "valid": true }
  },
  {
    "name": "length upper bound",
    "rules": [{ "key": "length", "min": 1, "max": 4 }],
    "password": "abcde",
    "expected": { "rules": { "length": false }, "valid": false }
  },
  {
    "name": "builtin and custom mixed failure",
    "rules": [
      { "key": "length", "min": 1, "max": 99 },
      { "key": "symbol", "pattern": "[^A-Za-z0-9]", "min": 1 }
    ],
    "password": "abc",
    "expected": { "rules": { "length": true, "symbol": false }, "valid": false }
  },
  {
    "name": "distinct per-rule minimums both met",
    "rules": [
      { "key": "digit", "pattern": "\\d", "min": 2 },
      { "key": "uppercase", "pattern": "[A-Z]", "min": 3 }
    ],
    "password": "ABCde12",
    "expected": { "rules": { "digit": true, "uppercase": true }, "valid": true }
  },
  {
    "name": "distinct per-rule minimums swapped fails the tighter rule",
    "rules": [
      { "key": "digit", "pattern": "\\d", "min": 3 },
      { "key": "uppercase", "pattern": "[A-Z]", "min": 2 }
    ],
    "password": "ABCde12",
    "expected": { "rules": { "digit": false, "uppercase": true }, "valid": false }
  },
  {
    "name": "no rules is invalid",
    "rules": [],
    "password": "anything",
    "expected": { "rules": {}, "valid": false }
  },
  {
    "name": "non-ascii characters count toward length",
    "rules": [{ "key": "length", "min": 1, "max": 3 }],
    "password": "café",
    "expected": { "rules": { "length": false }, "valid": false }
  }
]
