  "dates": [
    {
      "name": "bounds give their dates",
      "availability": {
        "min": "2026-11-03T22:00",
        "max": "2026-11-04T02:00"
      },
      "expect": {
        "min": "2026-11-03",
        "max": "2026-11-04",
        "disabledDates": [],
        "disabledWeekdays": [],
        "disabledMonths": [],
        "disabledYears": []
      }
    },
    {
      "name": "a min past the last step leaves its date empty",
      "availability": {
        "min": "2026-11-03T23:50",
        "time": {
          "step": 15
        }
      },
      "expect": {
        "min": "2026-11-03",
        "max": null,
        "disabledDates": ["2026-11-03"],
        "disabledWeekdays": [],
        "disabledMonths": [],
        "disabledYears": []
      }
    },
    {
      "name": "a min after the daily window leaves its date empty",
      "availability": {
        "min": "2026-11-03T18:00",
        "time": {
          "max": "17:00"
        }
      },
      "expect": {
        "min": "2026-11-03",
        "max": null,
        "disabledDates": ["2026-11-03"],
        "disabledWeekdays": [],
        "disabledMonths": [],
        "disabledYears": []
      }
    },
    {
      "name": "date rules pass through",
      "availability": {
        "disabledWeekdays": [0, 6],
        "disabledDates": ["2026-12-25"]
      },
      "expect": {
        "min": null,
        "max": null,
        "disabledDates": ["2026-12-25"],
        "disabledWeekdays": [0, 6],
        "disabledMonths": [],
        "disabledYears": []
      }
    },
    {
      "name": "a wrapped window keeps the evening on min's date",
      "availability": {
        "min": "2026-11-03T02:30",
        "time": {
          "min": "22:00",
          "max": "02:00"
        }
      },
      "expect": {
        "min": "2026-11-03",
        "max": null,
        "disabledDates": [],
        "disabledWeekdays": [],
        "disabledMonths": [],
        "disabledYears": []
      }
    },
    {
      "name": "a max before the daily window leaves its date empty",
      "availability": {
        "max": "2026-11-04T08:00",
        "time": {
          "min": "09:00"
        }
      },
      "expect": {
        "min": null,
        "max": "2026-11-04",
        "disabledDates": ["2026-11-04"],
        "disabledWeekdays": [],
        "disabledMonths": [],
        "disabledYears": []
      }
    },
    {
      "name": "an empty date already disabled is listed once",
